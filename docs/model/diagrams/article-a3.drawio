        <mxCell id="title" value="A3. Vendor distress and client flight" style="html=0;fontFamily=Helvetica;fontSize=12;text;align=left;verticalAlign=top;fontSize=16;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="386" height="32" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="+ or - on an arrow: the link's polarity.&#10;R / B circle: a reinforcing / balancing loop.&#10;Box: a stock (it accumulates). Bold text: everything else." style="html=0;fontFamily=Helvetica;fontSize=12;text;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;strokeColor=#999999;fillColor=#FAFAFA;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="617" width="389" height="54" as="geometry" />
        </mxCell>
        <mxCell id="caption:1" value="A vendor whose margin falls well below normal loses clients and cuts staff; lost clients&#10;cut its revenue and margin further. Over time clients get used to the distress, so the&#10;flight fades. In the model it never acts in Base. It acts in short spells of about one to&#10;three years in five scenarios, mostly for the Indian IT vendors: the stress set 'Fast AI +&#10;OIT price shock', Compute shock, Visa relaxation, Jevons rebound and Demand boom." style="html=0;fontFamily=Helvetica;fontSize=12;text;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="459" y="617" width="593" height="81" as="geometry" />
        </mxCell>
