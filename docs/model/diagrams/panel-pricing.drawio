        <mxCell id="legend" value="Box: a stock. Bold text: an auxiliary. Colour: its module.&#10;+ or - on an arrow: the link's polarity.&#10;R / B circle: a reinforcing / balancing loop acting in Base.&#10;? in a circle: the loop's sign depends on which path dominates.&#10;Hexagon: a limit on the link beside it." style="html=0;fontFamily=Helvetica;fontSize=12;text;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;strokeColor=#999999;fillColor=#FAFAFA;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="789" width="420" height="81" as="geometry" />
        </mxCell>
        <mxCell id="caption:1" value="? U1: closes through productivity (work over effort), where two parallel paths have opposite signs." style="html=0;fontFamily=Helvetica;fontSize=12;text;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="490" y="789" width="650" height="26" as="geometry" />
        </mxCell>
        <mxCell id="caption:2" value="B2 (T&amp;M paradox) is reinforcing in the code, against the spec's balancing (E35)." style="html=0;fontFamily=Helvetica;fontSize=12;text;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="490" y="819" width="529" height="26" as="geometry" />
        </mxCell>
        <mxCell id="caption:3" value="C6 caps the AI discount clients expect (limit marker).&#10;It binds only in the Fast AI scenario and the stress set, from mid-2030." style="html=0;fontFamily=Helvetica;fontSize=12;text;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#333333;" vertex="1" parent="1">
