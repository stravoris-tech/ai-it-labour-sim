        </mxCell>
        <mxCell id="legend" value="+ or - on an arrow: the link's polarity.&#10;R / B circle: a reinforcing / balancing loop.&#10;Box: a stock (it accumulates). Bold text: everything else.&#10;Hexagon: a limit on the link beside it." style="html=0;fontFamily=Helvetica;fontSize=12;text;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;strokeColor=#999999;fillColor=#FAFAFA;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="389" height="67" as="geometry" />
        </mxCell>
        <mxCell id="caption:1" value="Every GCC that opens makes the next one easier; the work it takes comes out of vendors'&#10;books, and GCC hiring from vendors raises their costs. The advantage is capped: the loop&#10;feeds back until about 2032, then sits at its cap, a fixed shift with no further gain." style="html=0;fontFamily=Helvetica;fontSize=12;text;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="459" y="690" width="580" height="54" as="geometry" />
        </mxCell>
