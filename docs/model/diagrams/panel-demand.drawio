          <mxGeometry x="490" y="834" width="574" height="26" as="geometry" />
        </mxCell>
        <mxCell id="caption:2" value="R3 and U5 are dormant while JevonsEps is 0 (they act in the Jevons rebound scenario)." style="html=0;fontFamily=Helvetica;fontSize=12;text;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#333333;" vertex="1" parent="1">
