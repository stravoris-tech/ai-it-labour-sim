        <mxCell id="caption:1" value="P-C2 has two labels on one path: balancing through labour cost (B), reinforcing through capacity (R)." style="html=0;fontFamily=Helvetica;fontSize=12;text;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="478" y="880" width="663" height="26" as="geometry" />
        </mxCell>
        <mxCell id="caption:2" value="P-C4: client flight reinforces (R); clients getting used to the distress fade it (B)." style="html=0;fontFamily=Helvetica;fontSize=12;text;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#333333;" vertex="1" parent="1">
