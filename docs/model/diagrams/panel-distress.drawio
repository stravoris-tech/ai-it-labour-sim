        </mxCell>
        <mxCell id="caption:3" value="C5 and C6 are rules, not loops (limit markers). They bind only in the Fast AI scenario and the stress set:&#10;C5 (price floor) from 2028, C6 (AI-discount ceiling) from mid-2030." style="html=0;fontFamily=Helvetica;fontSize=12;text;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#333333;" vertex="1" parent="1">
