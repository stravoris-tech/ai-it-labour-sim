        <mxCell id="title" value="Panel 1. Labour market and hiring" style="html=0;fontFamily=Helvetica;fontSize=12;text;align=left;verticalAlign=top;fontSize=16;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="346" height="32" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Box: a stock. Bold text: an auxiliary. Colour: its module.&#10;+ or - on an arrow: the link's polarity.&#10;R / B circle: a reinforcing / balancing loop acting in Base.&#10;Dashed circle: weak in Base, or acting only in the stress set&#10;  'Fast AI + OIT price shock'.&#10;Grey circle: dormant in Base and in the stress set.&#10;? in a circle: the loop's sign depends on which path dominates.&#10;Dashed arrow: an open chain (no loop closes it).&#10;Faded arrow: every loop on it is dormant in Base.&#10;Hexagon: a limit on the link beside it." style="html=0;fontFamily=Helvetica;fontSize=12;text;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;strokeColor=#999999;fillColor=#FAFAFA;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="894" width="420" height="150" as="geometry" />
        </mxCell>
        <mxCell id="caption:1" value="? R5: balancing through hiring and unemployment, reinforcing only through the ageing chain (E10)." style="html=0;fontFamily=Helvetica;fontSize=12;text;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="490" y="894" width="637" height="26" as="geometry" />
        </mxCell>
        <mxCell id="caption:2" value="? U3: reinforcing on paper, with a gain near zero: switching keeps each pool's headcount." style="html=0;fontFamily=Helvetica;fontSize=12;text;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="490" y="924" width="586" height="26" as="geometry" />
        </mxCell>
        <mxCell id="caption:3" value="R4 (skill erosion) is replaced by its phase 9 term P-R4 and not drawn (E3)." style="html=0;fontFamily=Helvetica;fontSize=12;text;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="490" y="954" width="497" height="26" as="geometry" />
        </mxCell>
        <mxCell id="caption:4" value="P-R4 is balancing as built: more seekers mean longer spells and faster exits from IT, so fewer seekers." style="html=0;fontFamily=Helvetica;fontSize=12;text;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="490" y="984" width="676" height="26" as="geometry" />
        </mxCell>
